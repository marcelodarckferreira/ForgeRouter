# ForgeRouter environment

APP_ENV=local
APP_NAME=forgerouter
APP_HOST=127.0.0.1
APP_PORT=2100

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=forgerouter
POSTGRES_USER=forgerouter_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://forgerouter_user:change_me@localhost:5432/forgerouter

# Router storage schema/table prefix
AI_ROUTER_DB_SCHEMA=ai_router
AI_ROUTER_TABLE_PREFIX=ai_router_

# Safety defaults
ENABLE_PAID_FALLBACK=false
REDACT_SECRETS=true
LOG_PROMPTS=false

# Per-provider API keys — only required for the providers you enable
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Optional: shared secret for trusted SSO from a companion app (sent server-to-server)
FORGEHUB_SSO_SECRET=
